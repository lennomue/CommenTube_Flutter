# Copy this file to .env and fill in values only on your Mac.
YOUTUBE_API_KEY=replace_with_your_youtube_api_key
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=replace_with_an_available_model_id

# Optional experiment. The default pipeline does not require Jev.
TYPESAFE_API_KEY=replace_with_your_typesafe_api_key
JEV_MODEL=jev-latest
